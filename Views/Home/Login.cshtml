@model ShopBuStore.Models.User
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex w-100 justify-content-center mt-5">
    <div class="card p-2 w-50 bg-light">
        <form method="post" asp-action="Login">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <h2 class="text-center">Login</h2>
            <div class="form-group">
                <label class="form-label" for="email">Email:</label>
                <input class="form-control" type="text" asp-for=Email id="email" name="email" required />
            </div>
            <div class="form-group">
                <label class="form-label" for="password">Password:</label>
                <input class="form-control" type="password" asp-for=Password id="password" name="password" required />
            </div>
            <span class="text-danger">@ViewBag.Message</span>
            <div class="d-flex justify-content-center">
                <button class="btn btn-dark mt-2" type="submit">Login</button>
            </div>
        </form>
    </div>
</div>


